# Set via Firebase Secrets in production:
#   firebase functions:secrets:set LICENSE_PEPPER
# MUST match the LICENSE_PEPPER secret in your KamChi mobile app backend.
LICENSE_PEPPER="REPLACE_WITH_SHARED_HIGH_ENTROPY_PEPPER"

# Optional: set to "false" ONLY when running local Firebase emulators without App Check.
ENFORCE_APP_CHECK="true"

# Optional: set if your KamChi project uses a named Firestore database instead of "(default)".
FIRESTORE_DATABASE_ID=""
