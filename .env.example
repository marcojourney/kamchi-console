# =============================================================================
# KamChi License Admin — Root Environment Variables Example
# Copy values into Firebase Secrets / .env files as noted in README.md.
# Never commit real secrets.
# =============================================================================

# [FILL IN] Your KamChi mobile app Firebase project ID
FIREBASE_PROJECT_ID="YOUR_KAMCHI_FIREBASE_PROJECT_ID"

# [FILL IN] Comma-separated allowlist of admin emails for scripts/setAdminClaim.ts
ADMIN_EMAILS="owner@example.com,trusted-admin@example.com"

# [FILL IN via Firebase Secrets] Secret pepper used for HMAC-SHA256 key hashing.
# MUST match the LICENSE_PEPPER used by the KamChi mobile app backend.
# Set with: firebase functions:secrets:set LICENSE_PEPPER
LICENSE_PEPPER=""

# Optional: Gemini API key if using AI Studio runtime environment
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
