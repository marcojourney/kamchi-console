# =============================================================================
# KamChi Admin UI — Environment Configuration
# Copy to admin/.env.production (or admin/.env.local) and fill in your
# KamChi mobile app Firebase Web SDK config.
# =============================================================================

# [FILL IN] Firebase Web App configuration from your KamChi Firebase project
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_KAMCHI_FIREBASE_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_KAMCHI_FIREBASE_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_KAMCHI_FIREBASE_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_WEB_APP_ID"

# Optional: only set if your KamChi project uses a named Firestore database
VITE_FIREBASE_DATABASE_ID=""

# Must match the Cloud Functions region in /functions/src/index.ts
VITE_FUNCTIONS_REGION="asia-southeast1"

# [FILL IN] Firebase App Check reCAPTCHA v3 site key (from Firebase Console -> App Check)
VITE_RECAPTCHA_SITE_KEY=""
