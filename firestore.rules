rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: deny every path by default
    match /{document=**} {
      allow read, write: if false;
    }

    // License records are strictly server-only via Cloud Functions (Admin SDK)
    match /licenses/{keyHash} {
      allow read, write: if false;
    }

    // Audit logs are append-only by Cloud Functions (Admin SDK)
    match /adminAuditLog/{logId} {
      allow read, write: if false;
    }

    // Rate-limit counters are managed exclusively by Cloud Functions (Admin SDK)
    match /adminRateLimits/{uid} {
      allow read, write: if false;
    }
  }
}
